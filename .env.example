# Kopiér til .env lokalt, eller indtast i Vercel -> Settings -> Environment Variables.
# Læg ALDRIG rigtige nøgler i dette eksempel eller i repositoryet.
ANTHROPIC_API_KEY=
ACCESS_CODE=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Login (valgfrit). Kun aktivt, når ALLE fire er sat. Se README.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
ALLOWED_EMAIL=
# Valgfri: din faste adresse, fx https://dit-projekt.vercel.app
PUBLIC_URL=
